{
  "name": "prairie-practice",
  "version": "0.1.0",
  "private": true,
  "description": "Prairie Practice: a practice test app for the ATS AI workshop. All data is invented.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/src/index.js",
    "dev:web": "vite",
    "seed": "node --env-file-if-exists=.env server/src/seed.js",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run --project=app && playwright test --project=app",
    "test:unit": "vitest run --project=app",
    "test:e2e": "playwright test --project=app",
    "workshop-key": "node .devcontainer/workshop-key.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.15.0",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router": "^7.18.6",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "supertest": "^7.3.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "playwright-core": "1.58.2"
  }
}
